#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: bb ticket comment T-YYYY-MM-DD-NNN "comment body" [--by actor]\n' >&2
}

root="${BABS_ROOT:-}"
if [[ -z "$root" ]]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  root="$(cd "$script_dir/.." && pwd)"
fi

if [[ "$#" -lt 4 || "${1:-}" != "ticket" || "${2:-}" != "comment" ]]; then
  usage
  exit 64
fi

ticket_id="$3"
body="$4"
shift 4

by="${BABS_CITIZEN_SLUG:-user}"

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --by)
      if [[ "$#" -lt 2 ]]; then
        usage
        exit 64
      fi
      by="$2"
      shift 2
      ;;
    *)
      usage
      exit 64
      ;;
  esac
done

cd "$root"
cmd=(mise exec -- mix babs.ticket.comment "$ticket_id" "$body" --by "$by")
exec "${cmd[@]}"
